   <property name="geometry">
    <rect>
     <x>90</x>
     <y>10</y>
     <width>271</width>
     <height>20</height>
    </rect>
   </property>
  </widget>
  <widget class="QPushButton" name="pushButtonBrowse">
   <property name="geometry">
    <rect>
     <x>370</x>
     <y>10</y>
     <width>81</width>
     <height>23</height>
    </rect>
   </property>
   <property name="text">
    <string>Browse...</string>
   </property>
  </widget>
  <widget class="QLabel" name="label">
   <property name="geometry">
    <rect>
     <x>10</x>
     <y>10</y>
     <width>71</width>
     <height>16</height>
    </rect>
   </property>
   <property name="text">
    <string>Image path</string>
   </property>
  </widget>
  <widget class="QCheckBox" name="checkBoxRotationMode">
   <property name="geometry">
    <rect>
     <x>10</x>
     <y>40</y>
     <width>247</width>
     <height>17</height>
    </rect>
   </property>
   <property name="toolTip">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;If checked, the raster will be exported as is and the world file will contain the rotation, scaling and translation. Some GIS software may not be able to georeference the raster correctly in this mode. If unchecked, the raster will be modified with the rotation and the scaling between axis and the world file will contain the rest of the transformation.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
   <property name="text">
    <string>Put rotation in world file </string>
   </property>
  </widget>
  <widget class="QCheckBox" name="checkBoxOnlyWorldFile">
   <property name="geometry">
    <rect>
     <x>10</x>
     <y>65</y>
     <width>279</width>
     <height>17</height>
    </rect>
   </property>
   <property name="toolTip">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;If checked, only the world file will be exported and the chosen file will not be overwritten. The rotation will be included in the world file.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
   <property name="text">
    <string>Only export world file for chosen raster</string>
   </property>
  </widget>
  <widget class="QCheckBox" name="checkBoxExportCOG">
   <property name="geometry">
    <rect>
     <x>10</x>
     <y>90</y>
     <width>441</width>
     <height>17</height>
    </rect>
   </property>
   <property name="toolTip">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Export a Cloud Optimized GeoTIFF built from the original raster file (any band count / data type is preserved) with the georeferencing of the layer.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
   <property name="text">
    <string>Export as COG (Cloud Optimized GeoTIFF)</string>
   </property>
  </widget>
  <widget class="QLabel" name="labelResampling">
   <property name="geometry">
    <rect>
     <x>10</x>
     <y>118</y>
     <width>180</width>
     <height>16</height>
    </rect>
   </property>
   <property name="text">
    <string>Resampling (north-up COG):</string>
   </property>
  </widget>
  <widget class="QComboBox" name="comboBoxResampling">
   <property name="geometry">
    <rect>
     <x>195</x>
     <y>114</y>
     <width>160</width>
     <height>24</height>
    </rect>
   </property>
   <property name="toolTip">
    <string>Resampling method used when the rotation is baked into pixels (north-up COG)</string>
   </property>
   <item>
    <property name="text">
     <string>Nearest neighbour</string>
    </property>
   </item>
   <item>
    <property name="text">
     <string>Bilinear</string>
    </property>
   </item>
   <item>
    <property name="text">
     <string>Cubic</string>
    </property>
   </item>
  </widget>
  <widget class="QLabel" name="labelCompression">
   <property name="geometry">
    <rect>
     <x>10</x>
     <y>146</y>
     <width>180</width>
     <height>16</height>
    </rect>
   </property>
   <property name="text">
    <string>Compression (GeoTIFF/COG):</string>
   </property>
  </widget>
  <widget class="QComboBox" name="comboBoxCompression">
   <property name="geometry">
    <rect>
     <x>195</x>
     <y>142</y>
     <width>160</width>
     <height>24</height>
    </rect>
   </property>
   <property name="toolTip">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Compression of the exported GeoTIFF / COG. DEFLATE and ZSTD are lossless; JPEG and WEBP are lossy (much smaller files, photographic content). JPEG cannot store the alpha band added by the north-up warp: DEFLATE is used instead in that case. If this GDAL build lacks a codec, DEFLATE is used as a fallback.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
  </widget>
 </widget>
