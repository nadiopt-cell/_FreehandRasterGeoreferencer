   </rect>
  </property>
  <property name="windowTitle">
   <string>Export georeferenced raster</string>
  </property>
  <widget class="QDialogButtonBox" name="buttonBox">
   <property name="geometry">
    <rect>
     <x>112</x>
     <y>81</y>
     <width>341</width>
